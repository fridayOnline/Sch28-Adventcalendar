# Supabase（サーバー専用。NEXT_PUBLIC_ は絶対に付けない）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 管理画面
ADMIN_PASSWORD=
SESSION_SECRET=

# IPハッシュ用ソルト
IP_HASH_SALT=

# 開催年
EVENT_YEAR=2026

# ---- 開発用（本番 NODE_ENV=production では無視される） ----
# 「今」を固定する。例：12/12 の朝の状態を見る
# DEV_NOW=2026-12-12T09:00:00+09:00
# 1 にすると Supabase につながず、モックデータ入りのインメモリDBで動く（編集用パスワードは test）
# DEV_MOCK_DATA=1
